{
  "name": "text-cleaner",
  "description": "生成AIに渡す前の文章から個人情報・機密情報を端末内で検出・加工し、判断を支援するChrome拡張",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:demo": "WXT_REPORT_ORIGIN=http://localhost:8787 wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "WXT_REPORT_ORIGIN=http://localhost:8787 wxt build && playwright test",
    "setup:ner": "node scripts/setup-ner.mjs",
    "postinstall": "wxt prepare",
    "server": "tsx server/src/main.ts",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts"
  },
  "dependencies": {
    "@expo-google-fonts/biz-udpgothic": "0.4.2",
    "@hono/node-server": "2.1.3",
    "@huggingface/transformers": "4.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/standard-fonts": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": "^22.23.4"
  }
}
