{
  "name": "text-cleaner",
  "description": "生成AIに渡す前の文章から個人情報・機密情報を端末内で検出・加工し、判断を支援するChrome拡張",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "setup:ner": "node scripts/setup-ner.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
